<!DOCTYPE html>
<html>
<head>
    <title>Foodie Restaurant</title>

    <style>
        body {
            font-family: Arial;
            background-color: #d8d9e1;
            margin: 0;
            text-align: center;
        }

        header {
            background-color: rgb(105, 172, 138);
            color: white;
            padding: 20px;
        }

        nav {
            background-color: #333;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        h2 {
            color: rgb(114, 173, 173);
        }

        .food {
            background-color: white;
            display: inline-block;
            width: 250px;
            margin: 15px;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 0 8px gray;
            vertical-align: top;
        }

        .food img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 8px;
        }

        .price {
            color: rgb(160, 105, 119);
            font-size: 20px;
            font-weight: bold;
        }

        button {
            background-color: orangered;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        .offer {
            background-color: rgb(221, 194, 171);
            color: white;
            padding: 20px;
        }

        footer {
            background-color: #333;
            color: white;
            padding: 15px;
            margin-top: 30px;
        }

        
        
    </style>
</head>

<body>

    <header>
        <h1>🍔 Foodie Restaurant</h1>
        <p>Delicious Food at Your Doorstep!</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#menu">Menu</a>
        <a href="#offers">Offers</a>
        <a href="#reviews">Reviews</a>
    </nav>

    <section id="home">
        <h2>Welcome to Foodie!</h2>
        <p>Enjoy tasty food at affordable prices.</p>
        <p>📍 Vijayawada | ⭐ 4.5 Rating</p>
    </section>

    <section id="menu">
        <h2>Our Food Menu</h2>

        <div class="food">
            <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=500&q=80" alt="Pizza">
            <h3>Pizza</h3>
            <p>Cheesy and delicious pizza.</p>
            <p class="price">₹199</p>
            <button>Order Now</button>
        </div>

        <div class="food">
            <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=500&q=80" alt="Burger">
            <h3>Burger</h3>
            <p>Fresh and tasty burger.</p>
            <p class="price">₹99</p>
            <button>Order Now</button>
        </div>

        <div class="food">
            <img src="https://th.bing.com/th/id/OIP.2iWS4NJfB5y_mu30Nsq_bwHaHa?w=193&h=193&c=7&r=0&o=7&dpr=1.5&pid=1.7&rm=3" alt="Biryani">
            <h3>Chicken Biryani</h3>
            <p>Hot and spicy biryani.</p>
            <p class="price">₹180</p>
            <button>Order Now</button>
        </div>

        <div class="food">
            <img src="https://images.unsplash.com/photo-1563805042-7684c019e1cb?auto=format&fit=crop&w=500&q=80" alt="Ice cream">
            <h3>Ice Cream</h3>
            <p>Sweet and creamy dessert.</p>
            <p class="price">₹60</p>
            <button>Order Now</button>
        </div>
        <div class="food">
            <img src="https://i.pinimg.com/200x150/40/4e/b5/404eb50e049e33459e8493277919e741.jpg" alt="french fries">
            <h3>French fries</h3>
            <p>crispy and tasty fries.</p>
            <p class="price">₹90</p>
            <button>Order Now</button>
        </div>
        
            <div class="food">
            <img src="https://www.shutterstock.com/shutterstock/photos/2429890705/display_1500/stock-photo-top-view-of-ten-fried-chicken-momos-typical-filled-dumplings-2429890705.jpg" alt="Momos">
             <h3>Chicken Momos</h3>
            <p>Hot and crispy .</p>
            <p class="price">₹180</p>
            <button>Order Now</button>
        </div>

    </section>

    <section class="offer" id="offers">
        <h2>Special Offer!</h2>
        <p>Get 20% OFF on your first order.</p>
    </section>

    <section id="reviews">
        <h2>Customer Reviews</h2>
        <p>⭐⭐⭐⭐⭐ Great food and excellent taste!</p>
        <p>⭐⭐⭐⭐ Fast service and affordable prices!</p>
    </section>
<footer>
        <p>Contact: foodie@example.com</p>
        <p>© 2026 Foodie Restaurant</p>
    </footer>

</body>
</html>
